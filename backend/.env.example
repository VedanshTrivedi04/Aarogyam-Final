# MedAdhere Environment Variables
SECRET_KEY=django-insecure-z#t_8z_z_z_z_z_z_z_z_z_z_z_z_z_z_z_z_z_z_z
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=medadhere
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT (start.sh only launches scripts/mqtt_bridge.py when MQTT_BROKER is set)
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=FTfj8PaRznG-EzZE15kykhzkSTm8KREcOLEC6pueCQY=

# Twilio — SMS, Voice IVR, and WhatsApp (Sandbox by default; see console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Sandbox WhatsApp number — same for every Twilio account until you get an
# approved Sender. Webhook URL to register in the Twilio console:
# https://<your-backend>/api/v1/whatsapp/webhook/
TWILIO_WHATSAPP_FROM=+14155238886

# FCM (Push Notifications)
FCM_SERVER_KEY=

# SendGrid (Email Primary)
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@medadhere.com

# SMTP Fallback (Used if SENDGRID_API_KEY is empty)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Sentry
SENTRY_DSN=

# Frontend
FRONTEND_URL=http://localhost:5173
